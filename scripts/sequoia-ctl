#!/usr/bin/env bash
# ==============================================================================
# Sequoia Control CLI (sequoia-ctl)
# Unified management tool for presets, layer overrides, edit mode, and safe-mode
# Target: Linux Mint 22.3 XFCE (X11)
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

CONFIG_DIR="${HOME}/.config/sequoia"
PRESETS_DIR="${REPO_ROOT}/themes/presets"
USER_CONFIG="${CONFIG_DIR}/user.json"
LAYOUT_CONFIG="${CONFIG_DIR}/layout.json"
GENERATED_DIR="${CONFIG_DIR}/generated"

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_RED="\033[1;31m"
C_YELLOW="\033[1;33m"
C_BLUE="\033[1;34m"
C_CYAN="\033[1;36m"

mkdir -p "${CONFIG_DIR}" "${GENERATED_DIR}"

log_info() { printf "${C_BLUE}==>${C_RESET} %s\n" "$*"; }
log_success() { printf "  ${C_GREEN}✔${C_RESET} %s\n" "$*"; }
log_warn() { printf "  ${C_YELLOW}⚠ Warning:${C_RESET} %s\n" "$*"; }
log_error() { printf "  ${C_RED}✖ Error:${C_RESET} %s\n" "$*" >&2; }

# Initialize user.json with default preset if missing
init_config() {
    if [[ ! -f "${USER_CONFIG}" ]]; then
        if [[ -f "${PRESETS_DIR}/default.json" ]]; then
            cp "${PRESETS_DIR}/default.json" "${USER_CONFIG}"
        else
            echo '{"name":"default","profile":"lite","accent":"#007AFF"}' > "${USER_CONFIG}"
        fi
    fi
    if [[ ! -f "${LAYOUT_CONFIG}" && -f "${REPO_ROOT}/config/sequoia/layout.json" ]]; then
        cp "${REPO_ROOT}/config/sequoia/layout.json" "${LAYOUT_CONFIG}"
    fi
}

cmd_status() {
    init_config
    echo "=========================================================="
    printf "${C_CYAN}${C_BOLD}%s${C_RESET}\n" " macOS Sequoia System Status (sequoia-ctl)"
    echo "=========================================================="
    
    local active_preset
    active_preset="$(grep -oE '"name":[[:space:]]*"[^"]+"' "${USER_CONFIG}" 2>/dev/null | cut -d'"' -f4 || echo "default")"
    printf "  Active Preset:      ${C_BOLD}%s${C_RESET}\n" "${active_preset}"
    
    # Compositor status
    if pgrep -x picom &>/dev/null; then
        local p_pid
        p_pid="$(pgrep -x picom | head -1)"
        printf "  Compositor:         ${C_GREEN}RUNNING${C_RESET} (Picom 10.2, PID %s)\n" "${p_pid}"
    else
        local xfwm_comp="unknown"
        if command -v xfconf-query &>/dev/null; then
            xfwm_comp="$(xfconf-query -c xfwm4 -p /general/use_compositing 2>/dev/null || echo "false")"
        fi
        if [[ "${xfwm_comp}" == "true" ]]; then
            printf "  Compositor:         ${C_YELLOW}SAFE-MODE${C_RESET} (xfwm4 native compositor)\n"
        else
            printf "  Compositor:         ${C_RED}STOPPED${C_RESET} (no compositor active)\n"
        fi
    fi

    # Panel status
    if pgrep -x xfce4-panel &>/dev/null; then
        local p_locked="locked"
        if command -v xfconf-query &>/dev/null; then
            local is_lock
            is_lock="$(xfconf-query -c xfce4-panel -p /panels/panel-1/position-locked 2>/dev/null || echo "true")"
            [[ "${is_lock}" == "false" ]] && p_locked="${C_YELLOW}EDIT-MODE (unlocked)${C_RESET}"
        fi
        printf "  Top Menu Bar:       ${C_GREEN}RUNNING${C_RESET} (28px height, %s)\n" "${p_locked}"
    else
        printf "  Top Menu Bar:       ${C_RED}NOT RUNNING${C_RESET}\n"
    fi

    # Plank Dock status
    if pgrep -x plank &>/dev/null; then
        local d_items
        d_items="$(find "${HOME}/.config/plank/dock1/launchers" -maxdepth 1 -name '*.dockitem' 2>/dev/null | wc -l || echo 0)"
        printf "  Plank Dock:         ${C_GREEN}RUNNING${C_RESET} (%d pinned icons)\n" "${d_items}"
    else
        printf "  Plank Dock:         ${C_RED}NOT RUNNING${C_RESET}\n"
    fi

    # Widgets status
    local c_count
    c_count="$(pgrep -c -x conky || echo 0)"
    if (( c_count > 0 )); then
        printf "  Desktop Widgets:    ${C_GREEN}RUNNING${C_RESET} (%s windows)\n" "${c_count}"
    else
        printf "  Desktop Widgets:    ${C_RED}NOT RUNNING${C_RESET}\n"
    fi

    echo "=========================================================="
}

cmd_preset() {
    local target="${1:-}"
    if [[ -z "${target}" ]]; then
        echo "Available Presets:"
        for p in "${PRESETS_DIR}"/*.json; do
            [[ -f "${p}" ]] || continue
            local pname
            pname="$(basename "${p}" .json)"
            local pdesc
            pdesc="$(grep -oE '"description":[[:space:]]*"[^"]+"' "${p}" 2>/dev/null | cut -d'"' -f4 || echo "")"
            printf "  • ${C_BOLD}%-14s${C_RESET} - %s\n" "${pname}" "${pdesc}"
        done
        return 0
    fi

    local pfile="${PRESETS_DIR}/${target}.json"
    if [[ ! -f "${pfile}" ]]; then
        log_error "Preset not found: ${target} (Checked ${PRESETS_DIR}/${target}.json)"
        return 1
    fi

    log_info "Applying preset: ${target}..."
    cp "${pfile}" "${USER_CONFIG}"
    
    # Regenerate tokens and reload
    cmd_apply
    log_success "Preset '${target}' applied successfully."
}

cmd_apply() {
    init_config
    log_info "Generating active stylesheets from user config..."
    
    local bg_color border_color fg_color accent_color
    bg_color="$(grep -oE '"bg_color":[[:space:]]*"[^"]+"' "${USER_CONFIG}" 2>/dev/null | head -1 | cut -d'"' -f4 || echo "rgba(20, 22, 30, 0.40)")"
    border_color="$(grep -oE '"border_color":[[:space:]]*"[^"]+"' "${USER_CONFIG}" 2>/dev/null | head -1 | cut -d'"' -f4 || echo "rgba(255, 255, 255, 0.14)")"
    fg_color="$(grep -oE '"fg_color":[[:space:]]*"[^"]+"' "${USER_CONFIG}" 2>/dev/null | head -1 | cut -d'"' -f4 || echo "#FFFFFF")"
    accent_color="$(grep -oE '"accent_color":[[:space:]]*"[^"]+"' "${USER_CONFIG}" 2>/dev/null | head -1 | cut -d'"' -f4 || echo "#00F0FF")"

    # Write GTK 3 tokens.css
    cat > "${HOME}/.config/gtk-3.0/sequoia/tokens.css" <<EOF
/* ==============================================================================
 * Design Tokens for GTK 3.0 (Generated by sequoia-ctl)
 * ============================================================================== */

@define-color sequoia_bg_panel ${bg_color};
@define-color sequoia_bg_menu rgba(30, 32, 40, 0.95);
@define-color sequoia_bg_card rgba(20, 24, 35, 0.00);
@define-color sequoia_accent #007aff;
@define-color sequoia_accent_active ${accent_color};
@define-color sequoia_fg ${fg_color};
@define-color sequoia_fg_hover ${accent_color};
@define-color sequoia_border ${border_color};
@define-color sequoia_hover rgba(255, 255, 255, 0.16);
@define-color sequoia_active rgba(0, 240, 255, 0.35);
@define-color sequoia_shadow rgba(0, 0, 0, 0.40);
EOF

    # Reload panel if running
    if pgrep -x xfce4-panel &>/dev/null; then
        xfce4-panel -r >/dev/null 2>&1 || true
    fi

    # Restart Conky if running
    if pgrep -x conky &>/dev/null; then
        "${SCRIPT_DIR}/conky-manager.sh" restart >/dev/null 2>&1 || true
    fi
}

cmd_edit() {
    local mode="${1:-}"
    if [[ "${mode}" == "on" ]]; then
        log_info "Enabling Edit Mode (unlocking top panel position)..."
        if command -v xfconf-query &>/dev/null; then
            xfconf-query -c xfce4-panel -p /panels/panel-1/position-locked -s false 2>/dev/null || true
        fi
        log_success "Top panel unlocked! You can now drag/reposition panel applets via right-click -> Panel -> Preferences."
        log_info "Run '${0} edit off' when finished to lock your layout."
    elif [[ "${mode}" == "off" ]]; then
        log_info "Disabling Edit Mode (locking top panel position)..."
        if command -v xfconf-query &>/dev/null; then
            xfconf-query -c xfce4-panel -p /panels/panel-1/position-locked -s true 2>/dev/null || true
        fi
        log_success "Top panel position locked."
    else
        echo "Usage: ${0} edit [on|off]"
        return 1
    fi
}

cmd_safe_mode() {
    local state="${1:-}"
    if [[ "${state}" == "on" ]]; then
        log_warn "Enabling Safe Mode (disabling Picom, enabling xfwm4 native compositing)..."
        pkill -x picom 2>/dev/null || true
        if command -v xfconf-query &>/dev/null; then
            xfconf-query -c xfwm4 -p /general/use_compositing -s true 2>/dev/null || true
        fi
        log_success "Safe mode active: xfwm4 compositing enabled."
    elif [[ "${state}" == "off" ]]; then
        log_info "Disabling Safe Mode (starting Picom, disabling xfwm4 compositing)..."
        if command -v xfconf-query &>/dev/null; then
            xfconf-query -c xfwm4 -p /general/use_compositing -s false 2>/dev/null || true
        fi
        picom --config "${HOME}/.config/picom/picom.conf" -b 2>/dev/null || true
        log_success "Picom compositor started."
    else
        echo "Usage: ${0} safe-mode [on|off]"
        return 1
    fi
}

cmd_export() {
    local out_file="${1:-sequoia-profile.json}"
    init_config
    cp "${USER_CONFIG}" "${out_file}"
    log_success "Profile exported to: ${out_file}"
}

cmd_import() {
    local in_file="${1:-}"
    if [[ ! -f "${in_file}" ]]; then
        log_error "File not found: ${in_file}"
        return 1
    fi
    cp "${in_file}" "${USER_CONFIG}"
    cmd_apply
    log_success "Profile imported from: ${in_file}"
}

case "${1:-status}" in
    status) cmd_status ;;
    preset) shift; cmd_preset "$@" ;;
    apply) cmd_apply ;;
    edit) shift; cmd_edit "$@" ;;
    safe-mode) shift; cmd_safe_mode "$@" ;;
    export) shift; cmd_export "$@" ;;
    import) shift; cmd_import "$@" ;;
    -h|--help|help)
        echo "Sequoia Control CLI (sequoia-ctl)"
        echo "Usage: sequoia-ctl <command> [args]"
        echo ""
        echo "Commands:"
        echo "  status                Show running session state and components"
        echo "  preset [name]         List presets or apply a preset (default, vibrant, sequoia-dark, enterprise)"
        echo "  edit on|off           Unlock or lock panel layout for drag/reposition"
        echo "  safe-mode on|off      Toggle Picom vs xfwm4 safe compositing"
        echo "  export <file.json>    Export active configuration"
        echo "  import <file.json>    Import configuration"
        ;;
    *)
        log_error "Unknown command: $1"
        echo "Run 'sequoia-ctl --help' for usage."
        exit 1
        ;;
esac
