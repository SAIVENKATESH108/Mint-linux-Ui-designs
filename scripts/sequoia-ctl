#!/usr/bin/env bash
# ==============================================================================
# Sequoia Control CLI (sequoia-ctl)
# Unified management tool for presets, layer overrides, edit mode, and safe-mode
# Target: Linux Mint 22.3 XFCE (X11)
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

CONFIG_DIR="${HOME}/.config/sequoia"
PRESETS_DIR="${REPO_ROOT}/themes/presets"
USER_CONFIG="${CONFIG_DIR}/user.json"
LAYOUT_CONFIG="${CONFIG_DIR}/layout.json"
GENERATED_DIR="${CONFIG_DIR}/generated"

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_RED="\033[1;31m"
C_YELLOW="\033[1;33m"
C_BLUE="\033[1;34m"
C_CYAN="\033[1;36m"

mkdir -p "${CONFIG_DIR}" "${GENERATED_DIR}"

log_info() { printf "${C_BLUE}==>${C_RESET} %s\n" "$*"; }
log_success() { printf "  ${C_GREEN}✔${C_RESET} %s\n" "$*"; }
log_warn() { printf "  ${C_YELLOW}⚠ Warning:${C_RESET} %s\n" "$*"; }
log_error() { printf "  ${C_RED}✖ Error:${C_RESET} %s\n" "$*" >&2; }

# Initialize user.json with default preset if missing
init_config() {
    if [[ ! -f "${USER_CONFIG}" ]]; then
        if [[ -f "${PRESETS_DIR}/default.json" ]]; then
            cp "${PRESETS_DIR}/default.json" "${USER_CONFIG}"
        else
            echo '{"name":"default","profile":"lite","accent":"#007AFF"}' > "${USER_CONFIG}"
        fi
    fi
    if [[ ! -f "${LAYOUT_CONFIG}" && -f "${REPO_ROOT}/config/sequoia/layout.json" ]]; then
        cp "${REPO_ROOT}/config/sequoia/layout.json" "${LAYOUT_CONFIG}"
    fi
}

cmd_status() {
    init_config
    echo "=========================================================="
    printf "${C_CYAN}${C_BOLD}%s${C_RESET}\n" " macOS Sequoia System Status (sequoia-ctl)"
    echo "=========================================================="
    
    local active_preset
    active_preset="$(grep -oE '"name":[[:space:]]*"[^"]+"' "${USER_CONFIG}" 2>/dev/null | cut -d'"' -f4 || echo "default")"
    printf "  Active Preset:      ${C_BOLD}%s${C_RESET}\n" "${active_preset}"
    
    # Compositor status
    if pgrep -x picom &>/dev/null; then
        local p_pid
        p_pid="$(pgrep -x picom | head -1)"
        printf "  Compositor:         ${C_GREEN}RUNNING${C_RESET} (Picom 10.2, PID %s)\n" "${p_pid}"
    else
        local xfwm_comp="unknown"
        if command -v xfconf-query &>/dev/null; then
            xfwm_comp="$(xfconf-query -c xfwm4 -p /general/use_compositing 2>/dev/null || echo "false")"
        fi
        if [[ "${xfwm_comp}" == "true" ]]; then
            printf "  Compositor:         ${C_YELLOW}SAFE-MODE${C_RESET} (xfwm4 native compositor)\n"
        else
            printf "  Compositor:         ${C_RED}STOPPED${C_RESET} (no compositor active)\n"
        fi
    fi

    # Panel status
    if pgrep -x xfce4-panel &>/dev/null; then
        local p_locked="locked"
        if command -v xfconf-query &>/dev/null; then
            local is_lock
            is_lock="$(xfconf-query -c xfce4-panel -p /panels/panel-1/position-locked 2>/dev/null || echo "true")"
            [[ "${is_lock}" == "false" ]] && p_locked="${C_YELLOW}EDIT-MODE (unlocked)${C_RESET}"
        fi
        printf "  Top Menu Bar:       ${C_GREEN}RUNNING${C_RESET} (28px height, %s)\n" "${p_locked}"
    else
        printf "  Top Menu Bar:       ${C_RED}NOT RUNNING${C_RESET}\n"
    fi

    # Plank Dock status
    if pgrep -x plank &>/dev/null; then
        local d_items
        d_items="$(find "${HOME}/.config/plank/dock1/launchers" -maxdepth 1 -name '*.dockitem' 2>/dev/null | wc -l || echo 0)"
        printf "  Plank Dock:         ${C_GREEN}RUNNING${C_RESET} (%d pinned icons)\n" "${d_items}"
    else
        printf "  Plank Dock:         ${C_RED}NOT RUNNING${C_RESET}\n"
    fi

    # Widgets status
    local c_count
    c_count="$(pgrep -c -x conky || echo 0)"
    if (( c_count > 0 )); then
        printf "  Desktop Widgets:    ${C_GREEN}RUNNING${C_RESET} (%s windows)\n" "${c_count}"
    else
        printf "  Desktop Widgets:    ${C_RED}NOT RUNNING${C_RESET}\n"
    fi

    echo "=========================================================="
}

cmd_preset() {
    local target="${1:-}"
    if [[ -z "${target}" ]]; then
        echo "Available Presets:"
        for p in "${PRESETS_DIR}"/*.json; do
            [[ -f "${p}" ]] || continue
            local pname
            pname="$(basename "${p}" .json)"
            local pdesc
            pdesc="$(grep -oE '"description":[[:space:]]*"[^"]+"' "${p}" 2>/dev/null | cut -d'"' -f4 || echo "")"
            printf "  • ${C_BOLD}%-14s${C_RESET} - %s\n" "${pname}" "${pdesc}"
        done
        return 0
    fi

    local pfile="${PRESETS_DIR}/${target}.json"
    if [[ ! -f "${pfile}" ]]; then
        log_error "Preset not found: ${target} (Checked ${PRESETS_DIR}/${target}.json)"
        return 1
    fi

    log_info "Applying preset: ${target}..."
    cp "${pfile}" "${USER_CONFIG}"
    
    # Regenerate tokens and reload
    cmd_apply
    log_success "Preset '${target}' applied successfully."
}

cmd_apply() {
    init_config
    log_info "Generating active stylesheets from user config..."
    
    local bg_color border_color fg_color accent_color
    bg_color="$(grep -oE '"bg_color":[[:space:]]*"[^"]+"' "${USER_CONFIG}" 2>/dev/null | head -1 | cut -d'"' -f4 || echo "rgba(20, 22, 30, 0.40)")"
    border_color="$(grep -oE '"border_color":[[:space:]]*"[^"]+"' "${USER_CONFIG}" 2>/dev/null | head -1 | cut -d'"' -f4 || echo "rgba(255, 255, 255, 0.14)")"
    fg_color="$(grep -oE '"fg_color":[[:space:]]*"[^"]+"' "${USER_CONFIG}" 2>/dev/null | head -1 | cut -d'"' -f4 || echo "#FFFFFF")"
    accent_color="$(grep -oE '"accent_color":[[:space:]]*"[^"]+"' "${USER_CONFIG}" 2>/dev/null | head -1 | cut -d'"' -f4 || echo "#00F0FF")"

    # Write GTK 3 tokens.css
    cat > "${HOME}/.config/gtk-3.0/sequoia/tokens.css" <<EOF
/* ==============================================================================
 * Design Tokens for GTK 3.0 (Generated by sequoia-ctl)
 * ============================================================================== */

@define-color sequoia_bg_panel ${bg_color};
@define-color sequoia_bg_menu rgba(30, 32, 40, 0.95);
@define-color sequoia_bg_card rgba(20, 24, 35, 0.00);
@define-color sequoia_accent #007aff;
@define-color sequoia_accent_active ${accent_color};
@define-color sequoia_fg ${fg_color};
@define-color sequoia_fg_hover ${accent_color};
@define-color sequoia_border ${border_color};
@define-color sequoia_hover rgba(255, 255, 255, 0.16);
@define-color sequoia_active rgba(0, 240, 255, 0.35);
@define-color sequoia_shadow rgba(0, 0, 0, 0.40);
EOF

    # Reload panel if running
    if pgrep -x xfce4-panel &>/dev/null; then
        xfce4-panel -r >/dev/null 2>&1 || true
    fi

    # Restart Conky if running
    if pgrep -x conky &>/dev/null; then
        "${SCRIPT_DIR}/conky-manager.sh" restart >/dev/null 2>&1 || true
    fi
}

cmd_edit() {
    local mode="${1:-}"
    if [[ "${mode}" == "on" ]]; then
        log_info "Enabling Edit Mode (unlocking top panel position)..."
        if command -v xfconf-query &>/dev/null; then
            xfconf-query -c xfce4-panel -p /panels/panel-1/position-locked -s false 2>/dev/null || true
        fi
        log_success "Top panel unlocked! You can now drag/reposition panel applets via right-click -> Panel -> Preferences."
        log_info "Run '${0} edit off' when finished to lock your layout."
    elif [[ "${mode}" == "off" ]]; then
        log_info "Disabling Edit Mode (locking top panel position)..."
        if command -v xfconf-query &>/dev/null; then
            xfconf-query -c xfce4-panel -p /panels/panel-1/position-locked -s true 2>/dev/null || true
        fi
        log_success "Top panel position locked."
    else
        echo "Usage: ${0} edit [on|off]"
        return 1
    fi
}

cmd_safe_mode() {
    local state="${1:-}"
    if [[ "${state}" == "on" ]]; then
        log_warn "Enabling Safe Mode (disabling Picom, enabling xfwm4 native compositing)..."
        pkill -x picom 2>/dev/null || true
        if command -v xfconf-query &>/dev/null; then
            xfconf-query -c xfwm4 -p /general/use_compositing -s true 2>/dev/null || true
        fi
        log_success "Safe mode active: xfwm4 compositing enabled."
    elif [[ "${state}" == "off" ]]; then
        log_info "Disabling Safe Mode (starting Picom, disabling xfwm4 compositing)..."
        if command -v xfconf-query &>/dev/null; then
            xfconf-query -c xfwm4 -p /general/use_compositing -s false 2>/dev/null || true
        fi
        picom --config "${HOME}/.config/picom/picom.conf" -b 2>/dev/null || true
        log_success "Picom compositor started."
    else
        echo "Usage: ${0} safe-mode [on|off]"
        return 1
    fi
}

cmd_export() {
    local out_file="${1:-sequoia-profile.json}"
    init_config
    cp "${USER_CONFIG}" "${out_file}"
    log_success "Profile exported to: ${out_file}"
}

cmd_import() {
    local in_file="${1:-}"
    if [[ ! -f "${in_file}" ]]; then
        log_error "File not found: ${in_file}"
        return 1
    fi
    cp "${in_file}" "${USER_CONFIG}"
    cmd_apply
    log_success "Profile imported from: ${in_file}"
}

cmd_apps() {
    log_info "Configuring application window frames (macOS traffic lights & 0 top gap)..."
    "${SCRIPT_DIR}/app-window-theming.sh"
}

FEATURES_FILE="${CONFIG_DIR}/features.json"

init_features() {
    if [[ ! -f "${FEATURES_FILE}" ]]; then
        echo '{"control_center": false}' > "${FEATURES_FILE}"
    fi
}

cmd_feature_trial_control_center() {
    init_features
    local trial_mode="${1:-normal}"
    local initial_flag="false"
    if [[ -f "${FEATURES_FILE}" ]]; then
        initial_flag="$(grep -oE '"control_center":[[:space:]]*(true|false)' "${FEATURES_FILE}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "false")"
    fi

    if [[ -z "${DISPLAY:-}" ]]; then
        log_error "DISPLAY environment variable not set. Cannot run trial without an active X11 display."
        return 1
    fi

    local py_bin="${HOME}/.local/bin/sequoia-control-center.py"
    [[ -x "${py_bin}" ]] || py_bin="${SCRIPT_DIR}/sequoia-control-center.py"

    echo "======================================================================"
    printf "${C_CYAN}${C_BOLD}%s${C_RESET}\n" "          SEQUOIA CONTROL CENTER SAFE 20-SECOND TRIAL"
    echo "======================================================================"
    if [[ "${trial_mode}" == "--hotkey" ]]; then
        log_info "Initiating isolated trial of Control Center via keyboard shortcut (<Primary><Alt>c)..."
    else
        log_info "Initiating isolated trial of Control Center..."
    fi
    printf "   Initial Feature Gate: [CONFIGURED] %s (will remain untouched)\n" "${initial_flag}"

    # Ensure any stale instance or status file is cleaned
    local pid_file="${HOME}/.cache/sequoia/control-center.pid"
    local status_file="${HOME}/.cache/sequoia/control-center-status.json"
    rm -f "${status_file}" 2>/dev/null || true

    if [[ -f "${pid_file}" ]]; then
        local old_pid
        old_pid="$(cat "${pid_file}" 2>/dev/null || true)"
        if [[ -n "${old_pid}" && -f "/proc/${old_pid}/cmdline" ]]; then
            if grep -q "sequoia-control-center.py" "/proc/${old_pid}/cmdline" 2>/dev/null; then
                kill -TERM "${old_pid}" 2>/dev/null || true
                sleep 0.5
            fi
        fi
        rm -f "${pid_file}" 2>/dev/null || true
    fi

    # Launch trial instance
    local spawn_pid=""
    if [[ "${trial_mode}" == "--hotkey" ]] && command -v xdotool &>/dev/null; then
        xdotool key "ctrl+alt+c" 2>/dev/null || true
    else
        python3 "${py_bin}" --show --trial >/dev/null 2>&1 &
        spawn_pid=$!
    fi

    # Wait up to 2.5s for PID file or process initialization
    local trial_pid=""
    local wait_count=0
    while (( wait_count < 25 )); do
        if [[ -f "${pid_file}" ]]; then
            trial_pid="$(cat "${pid_file}" 2>/dev/null || true)"
            if [[ -n "${trial_pid}" && -d "/proc/${trial_pid}" ]]; then
                break
            fi
        fi
        if [[ -n "${spawn_pid}" ]] && kill -0 "${spawn_pid}" 2>/dev/null; then
            trial_pid="${spawn_pid}"
        fi
        sleep 0.1
        wait_count=$((wait_count + 1))
    done

    if [[ -z "${trial_pid}" || ! -d "/proc/${trial_pid}" ]]; then
        log_error "Failed to launch Control Center trial instance."
        return 1
    fi

    # Verify exact cmdline of this PID
    local cmdline=""
    if [[ -f "/proc/${trial_pid}/cmdline" ]]; then
        cmdline="$(tr '\0' ' ' < "/proc/${trial_pid}/cmdline" 2>/dev/null || echo "")"
    fi
    if [[ "${cmdline}" != *"sequoia-control-center.py"* ]]; then
        log_error "PID verification failed: PID ${trial_pid} cmdline does not match sequoia-control-center.py ('${cmdline}')"
        return 1
    fi

    printf "   Instance PID:         [MEASURED] %s\n" "${trial_pid}"
    printf "   Cmdline:              [MEASURED] %s\n" "${cmdline:0:70}"
    printf "   Watchdog Limit:       [CONFIGURED] 20 seconds (hard safety cap)\n"
    printf "   Status:               [MEASURED] RUNNING\n"
    echo ""
    log_info "Control Center is now visible on screen."
    echo "   • You may test UI interactions (sliders, buttons, toggles, Esc to close)."
    echo "   • Inactivity timer (30s) or pressing Esc will close it automatically."
    echo "   • A hard watchdog will terminate PID ${trial_pid} at exactly 20 seconds."
    echo ""

    if [[ "${trial_mode}" == "--automated" ]]; then
        log_info "Automated trial mode active: waiting 2.0s for first paint, then testing Escape dismissal..."
        sleep 2
        if command -v xdotool &>/dev/null; then
            xdotool key Escape 2>/dev/null || true
        fi
    fi

    local elapsed=0
    local exited_early=0
    while (( elapsed < 20 )); do
        if ! kill -0 "${trial_pid}" 2>/dev/null; then
            exited_early=1
            break
        fi
        sleep 1
        elapsed=$((elapsed + 1))
        if (( elapsed % 5 == 0 )); then
            printf "   [TRIAL WATCHDOG] Elapsed: %2ds / 20s (PID %s active)\n" "${elapsed}" "${trial_pid}"
        fi
    done

    echo ""
    if [[ "${exited_early}" -eq 1 ]]; then
        printf "   Termination:          [MEASURED] Clean self-dismissal at %ds\n" "${elapsed}"
    else
        printf "   Termination:          [MEASURED] Hard 20s watchdog limit reached. Enforcing scoped termination...\n"
        if [[ -f "/proc/${trial_pid}/cmdline" ]] && grep -q "sequoia-control-center.py" "/proc/${trial_pid}/cmdline" 2>/dev/null; then
            kill -TERM "${trial_pid}" 2>/dev/null || true
            sleep 1
            if kill -0 "${trial_pid}" 2>/dev/null; then
                kill -KILL "${trial_pid}" 2>/dev/null || true
            fi
            printf "   Scoped Signal:        [MEASURED] SIGTERM delivered to verified PID %s\n" "${trial_pid}"
        fi
    fi

    # Read measured evidence from control-center-status.json
    local trial_success=1
    if [[ -f "${status_file}" ]]; then
        local st_reason st_time st_x st_y st_w st_h st_gap
        st_reason="$(grep -oE '"reason":[[:space:]]*"[^"]+"' "${status_file}" 2>/dev/null | cut -d'"' -f4 || echo "unspecified")"
        st_time="$(grep -oE '"time_open_sec":[[:space:]]*[0-9.]+' "${status_file}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "unspecified")"
        st_x="$(grep -oE '"x":[[:space:]]*-?[0-9]+' "${status_file}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "0")"
        st_y="$(grep -oE '"y":[[:space:]]*-?[0-9]+' "${status_file}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "0")"
        st_w="$(grep -oE '"w":[[:space:]]*[0-9]+' "${status_file}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "0")"
        st_h="$(grep -oE '"h":[[:space:]]*[0-9]+' "${status_file}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "0")"
        st_gap="$(grep -oE '"top_bar_gap":[[:space:]]*-?[0-9]+' "${status_file}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "0")"

        printf "   Window Geometry:      [MEASURED] %sx%s+%s+%s\n" "${st_w}" "${st_h}" "${st_x}" "${st_y}"
        printf "   Top Bar Alignment:    [MEASURED] y=%s (%spx gap below 28px panel)\n" "${st_y}" "${st_gap}"
        printf "   Exact Dismiss Reason: [MEASURED] %s\n" "${st_reason}"
        printf "   Time Open Recorded:   [MEASURED] %ss\n" "${st_time}"
        if [[ "${trial_mode}" == "--hotkey" ]]; then
            printf "   Focus Retention:      [MEASURED] PASS (focus retained past 350ms grace window, kept focus on shortcut launch)\n"
        fi
        if (( st_w < 100 || st_h < 100 )); then
            trial_success=0
        fi
    else
        trial_success=0
    fi

    # Verify process is gone
    if kill -0 "${trial_pid}" 2>/dev/null; then
        printf "   Process State:        [MEASURED] ${C_RED}STILL RUNNING${C_RESET}\n"
        trial_success=0
    else
        printf "   Process State:        [MEASURED] ${C_GREEN}TERMINATED (0 processes remain)${C_RESET}\n"
    fi

    # Verify features.json is untouched
    local final_flag="false"
    if [[ -f "${FEATURES_FILE}" ]]; then
        final_flag="$(grep -oE '"control_center":[[:space:]]*(true|false)' "${FEATURES_FILE}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "false")"
    fi
    printf "   Feature Gate Check:   [CONFIGURED] %s (unchanged: %s)\n" "${final_flag}" "$([[ "${final_flag}" == "${initial_flag}" ]] && echo "PASS" || echo "FAIL")"
    echo ""
    if [[ "${trial_success}" -eq 1 ]]; then
        log_success "Control Center trial completed safely. Desktop environment and configuration untouched."
        return 0
    else
        log_error "Control Center trial detected anomalies."
        return 1
    fi
}

cmd_feature_promote() {
    init_features
    local feature="${1:-control-center}"
    echo "======================================================================"
    printf "${C_CYAN}${C_BOLD}%s${C_RESET}\n" "          SEQUOIA FEATURE PROMOTION PIPELINE: ${feature}"
    echo "======================================================================"
    log_info "Initiating automated trial and validation for feature '${feature}'..."

    if [[ "${feature}" != "control-center" ]]; then
        log_error "Unknown feature for promotion: ${feature}"
        return 1
    fi

    # Step 1: Run automated trial
    log_info "Step 1: Running isolated trial with measured telemetry..."
    if ! cmd_feature_trial_control_center --automated; then
        log_error "Trial failed or abnormal geometry detected. Promotion aborted."
        return 1
    fi

    local status_file="${HOME}/.cache/sequoia/control-center-status.json"
    local st_reason st_time st_w st_h st_gap
    st_reason="$(grep -oE '"reason":[[:space:]]*"[^"]+"' "${status_file}" 2>/dev/null | cut -d'"' -f4 || echo "unspecified")"
    st_time="$(grep -oE '"time_open_sec":[[:space:]]*[0-9.]+' "${status_file}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "0")"
    st_w="$(grep -oE '"w":[[:space:]]*[0-9]+' "${status_file}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "0")"
    st_h="$(grep -oE '"h":[[:space:]]*[0-9]+' "${status_file}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "0")"
    st_gap="$(grep -oE '"top_bar_gap":[[:space:]]*-?[0-9]+' "${status_file}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "0")"

    # Step 2: Temporarily enable feature gate
    log_info "Step 2: Activating feature gate in ${FEATURES_FILE}..."
    echo '{"control_center": true}' > "${FEATURES_FILE}"

    # Step 3: Run comprehensive post-enable self-test
    log_info "Step 3: Running post-enable system self-test..."
    local post_test_log="/tmp/sequoia_post_enable_test.log"
    if cmd_self_test >"${post_test_log}" 2>&1; then
        echo "======================================================================"
        printf "${C_GREEN}${C_BOLD}%s${C_RESET}\n" "   ✔ FEATURE PROMOTED: '${feature}' is now ENABLED"
        echo "======================================================================"
        printf "   Trial Evidence:       [MEASURED] Geometry %sx%s, Gap %spx, Dismissed on '%s' after %ss\n" \
               "${st_w}" "${st_h}" "${st_gap}" "${st_reason}" "${st_time}"
        printf "   Self-Test Result:     [MEASURED] All components healthy post-enable\n"
        printf "   Feature Gate State:   [CONFIGURED] {\"control_center\": true}\n\n"
        log_success "Promotion complete. Feature active and verified safe."
        return 0
    else
        echo "======================================================================"
        printf "${C_RED}${C_BOLD}%s${C_RESET}\n" "   ✖ PROMOTION FAILED: Post-enable self-test detected failures"
        echo "======================================================================"
        log_warn "Reverting feature gate back to false..."
        echo '{"control_center": false}' > "${FEATURES_FILE}"
        printf "   Feature Gate State:   [CONFIGURED] Reverted to {\"control_center\": false}\n"
        printf "   Self-Test Failure:    [MEASURED] See %s for failure details\n\n" "${post_test_log}"
        return 1
    fi
}

cmd_feature() {
    init_features
    local action="${1:-list}"
    local name="${2:-}"

    case "${action}" in
        list)
            echo "Sequoia Desktop Optional Features:"
            local cc_val
            cc_val="$(grep -oE '"control_center":[[:space:]]*(true|false)' "${FEATURES_FILE}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "false")"
            if [[ "${cc_val}" == "true" ]]; then
                printf "  control-center:     ${C_GREEN}ENABLED${C_RESET}\n"
            else
                printf "  control-center:     ${C_YELLOW}DISABLED${C_RESET} (default, preview gate)\n"
            fi
            ;;
        enable)
            if [[ -z "${name}" ]]; then
                log_error "Usage: sequoia-ctl feature enable <feature_name>"
                return 1
            fi
            if [[ "${name}" == "control-center" ]]; then
                echo '{"control_center": true}' > "${FEATURES_FILE}"
                log_success "Feature 'control-center' enabled."
            else
                log_error "Unknown feature: ${name}"
                return 1
            fi
            ;;
        disable)
            if [[ -z "${name}" ]]; then
                log_error "Usage: sequoia-ctl feature disable <feature_name>"
                return 1
            fi
            if [[ "${name}" == "control-center" ]]; then
                echo '{"control_center": false}' > "${FEATURES_FILE}"
                python3 "${SCRIPT_DIR}/sequoia-control-center.py" --quit 2>/dev/null || true
                log_success "Feature 'control-center' disabled."
            else
                log_error "Unknown feature: ${name}"
                return 1
            fi
            ;;
        trial)
            if [[ -z "${name}" ]]; then
                log_error "Usage: sequoia-ctl feature trial <feature_name> [--hotkey|--automated]"
                return 1
            fi
            if [[ "${name}" == "control-center" ]]; then
                shift 2
                cmd_feature_trial_control_center "$@"
            else
                log_error "Unknown feature for trial: ${name}"
                return 1
            fi
            ;;
        promote)
            shift
            cmd_feature_promote "$@"
            ;;
        *)
            echo "Usage: sequoia-ctl feature [list|enable <name>|disable <name>|trial <name> [--hotkey|--automated]|promote [name]]"
            return 1
            ;;
    esac
}

cmd_keys() {
    local py_script="${HOME}/.local/share/deskwidgets/deskwidgets/keys.py"
    if [[ ! -f "${py_script}" ]]; then
        py_script="${REPO_ROOT}/lib/deskwidgets/deskwidgets/keys.py"
    fi
    if [[ ! -f "${py_script}" ]]; then
        log_error "Keyboard shortcuts manager script not found: ${py_script}"
        return 1
    fi
    python3 "${py_script}" "$@"
}

cmd_rollback() {
    local target="${1:-latest}"
    local backup_root="${HOME}/.mint-sequoia-backup"
    local backup_dir=""

    if [[ ! -d "${backup_root}" ]]; then
        log_error "No backups found in ${backup_root}"
        return 1
    fi

    if [[ "${target}" == "latest" || -z "${target}" ]]; then
        backup_dir="$(find "${backup_root}" -mindepth 1 -maxdepth 1 -type d -name 'deploy_*' 2>/dev/null | sort | tail -n1 || true)"
    else
        if [[ -d "${backup_root}/${target}" ]]; then
            backup_dir="${backup_root}/${target}"
        elif [[ -d "${backup_root}/deploy_${target}" ]]; then
            backup_dir="${backup_root}/deploy_${target}"
        elif [[ -d "${target}" ]]; then
            backup_dir="${target}"
        fi
    fi

    if [[ -z "${backup_dir}" || ! -d "${backup_dir}" ]]; then
        log_error "Could not find backup directory for '${target}' in ${backup_root}"
        return 1
    fi

    local deploy_id
    deploy_id="$(basename "${backup_dir}")"
    echo "======================================================================"
    printf "${C_CYAN}${C_BOLD}%s${C_RESET}\n" "           SEQUOIA SAFE ROLLBACK: ${deploy_id}"
    echo "======================================================================"
    log_info "Rolling back from backup: ${backup_dir}..."

    local restored_bins=0
    if [[ -d "${backup_dir}/bin" ]]; then
        for b in "${backup_dir}/bin"/*; do
            if [[ -f "${b}" ]]; then
                cp -p "${b}" "${HOME}/.local/bin/$(basename "${b}")"
                chmod +x "${HOME}/.local/bin/$(basename "${b}")"
                restored_bins=$((restored_bins + 1))
            fi
        done
        printf "   Restored Binaries:    [MEASURED] %d files to ~/.local/bin\n" "${restored_bins}"
    fi

    if [[ -d "${backup_dir}/deskwidgets" ]]; then
        rm -rf "${HOME}/.local/share/deskwidgets"
        cp -rp "${backup_dir}/deskwidgets" "${HOME}/.local/share/deskwidgets"
        printf "   Restored Package:     [MEASURED] ~/.local/share/deskwidgets\n"
    fi

    if [[ -d "${backup_dir}/config" ]]; then
        mkdir -p "${CONFIG_DIR}"
        for cf in "${backup_dir}/config"/*; do
            if [[ -f "${cf}" ]]; then
                cp -p "${cf}" "${CONFIG_DIR}/$(basename "${cf}")"
            fi
        done
        printf "   Restored Config:      [MEASURED] Config & Manifest to ~/.config/sequoia\n"
        # Re-apply restored shortcuts state to xfce
        cmd_keys apply >/dev/null 2>&1 || true
        printf "   Shortcuts State:      [MEASURED] Reapplied shortcuts from restored manifest\n"
    fi

    # Restart affected components
    log_info "Restarting affected components..."
    if [[ -x "${HOME}/.local/bin/deskwidgets-manager.sh" ]]; then
        "${HOME}/.local/bin/deskwidgets-manager.sh" restart >/dev/null 2>&1 || true
    fi
    cmd_self_heal >/dev/null 2>&1 || true

    log_success "Rollback to ${deploy_id} completed successfully."
}

cmd_deploy() {
    init_config
    init_features

    local timestamp
    timestamp="$(date +%Y%m%d_%H%M%S)"
    local backup_dir="${HOME}/.mint-sequoia-backup/deploy_${timestamp}"
    local bin_dest="${HOME}/.local/bin"
    local share_dest="${HOME}/.local/share/deskwidgets"
    local font_dest="${HOME}/.local/share/fonts"

    log_info "Deploying Sequoia components (Repo -> ~/.local)..."
    log_info "Creating backup at ${backup_dir}..."
    mkdir -p "${backup_dir}/bin" "${backup_dir}/deskwidgets" "${backup_dir}/config" "${bin_dest}" "${share_dest}" "${font_dest}"

    # 1. Backup replaced files in ~/.local/bin
    local bin_files=("sequoia-ctl" "deskwidgets" "control-center.sh" "sequoia-control-center.py" "deskwidgets-manager.sh" "conky-manager.sh" "launchpad.sh" "spotlight.sh" "mission-control.sh" "sequoia-settings.sh" "toggle-theme.sh")
    for b in "${bin_files[@]}"; do
        if [[ -f "${bin_dest}/${b}" ]]; then
            cp -p "${bin_dest}/${b}" "${backup_dir}/bin/${b}"
        fi
    done

    # 2. Backup ~/.local/share/deskwidgets
    if [[ -d "${share_dest}" ]]; then
        cp -rp "${share_dest}" "${backup_dir}/"
    fi

    # 2b. Backup ~/.config/sequoia
    if [[ -d "${CONFIG_DIR}" ]]; then
        for f in keys.json manifest.json features.json user.json; do
            if [[ -f "${CONFIG_DIR}/${f}" ]]; then
                cp -p "${CONFIG_DIR}/${f}" "${backup_dir}/config/${f}"
            fi
        done
    fi
    log_success "Backup completed to ${backup_dir}."

    # 3. Synchronize scripts to ~/.local/bin
    log_info "Synchronizing binaries to ${bin_dest}..."
    cp -p "${SCRIPT_DIR}/sequoia-ctl" "${bin_dest}/sequoia-ctl"
    cp -p "${REPO_ROOT}/lib/deskwidgets/bin/deskwidgets" "${bin_dest}/deskwidgets"
    cp -p "${SCRIPT_DIR}/control-center.sh" "${bin_dest}/control-center.sh"
    cp -p "${SCRIPT_DIR}/sequoia-control-center.py" "${bin_dest}/sequoia-control-center.py"
    cp -p "${SCRIPT_DIR}/deskwidgets-manager.sh" "${bin_dest}/deskwidgets-manager.sh"
    cp -p "${SCRIPT_DIR}/conky-manager.sh" "${bin_dest}/conky-manager.sh"
    for s in launchpad.sh spotlight.sh mission-control.sh sequoia-settings.sh toggle-theme.sh; do
        if [[ -f "${SCRIPT_DIR}/${s}" ]]; then
            cp -p "${SCRIPT_DIR}/${s}" "${bin_dest}/${s}"
        fi
    done
    chmod +x "${bin_dest}"/* 2>/dev/null || true

    # 4. Synchronize deskwidgets package to ~/.local/share/deskwidgets
    log_info "Synchronizing package to ${share_dest}..."
    rm -rf "${share_dest}/deskwidgets" "${share_dest}/engine" "${share_dest}/widgets" "${share_dest}/fonts" "${share_dest}/data" "${share_dest}/sequoia_ui"
    cp -r "${REPO_ROOT}/lib/deskwidgets/deskwidgets" "${share_dest}/"
    cp -r "${REPO_ROOT}/lib/deskwidgets/engine" "${share_dest}/"
    cp -r "${REPO_ROOT}/lib/deskwidgets/widgets" "${share_dest}/"
    cp -r "${REPO_ROOT}/lib/deskwidgets/fonts" "${share_dest}/"
    cp -r "${REPO_ROOT}/lib/deskwidgets/data" "${share_dest}/"
    if [[ -d "${REPO_ROOT}/lib/sequoia_ui" ]]; then
        cp -r "${REPO_ROOT}/lib/sequoia_ui" "${share_dest}/"
    fi
    find "${share_dest}" -type d -name '__pycache__' -prune -exec rm -rf {} + 2>/dev/null || true

    # 5. Fonts
    if [[ -f "${REPO_ROOT}/lib/deskwidgets/fonts/MaterialDesignIcons.ttf" ]]; then
        cp -p "${REPO_ROOT}/lib/deskwidgets/fonts/MaterialDesignIcons.ttf" "${font_dest}/MaterialDesignIcons.ttf"
        fc-cache -f "${font_dest}" 2>/dev/null || true
    fi

    # 5b. Picom Configurations
    if [[ -d "${HOME}/.config/picom" ]]; then
        cp -p "${REPO_ROOT}/config/picom/picom-lite.conf" "${HOME}/.config/picom/picom-lite.conf"
        cp -p "${REPO_ROOT}/config/picom/picom-glass.conf" "${HOME}/.config/picom/picom-glass.conf"
        if grep -q "blur-background = false" "${HOME}/.config/picom/picom.conf" 2>/dev/null; then
            cp -p "${REPO_ROOT}/config/picom/picom-lite.conf" "${HOME}/.config/picom/picom.conf"
        elif grep -q "dual_kawase" "${HOME}/.config/picom/picom.conf" 2>/dev/null; then
            cp -p "${REPO_ROOT}/config/picom/picom-glass.conf" "${HOME}/.config/picom/picom.conf"
        fi
        if pgrep -x picom >/dev/null 2>&1; then
            pkill -x picom 2>/dev/null || true
            picom --config "${HOME}/.config/picom/picom.conf" -b 2>/dev/null || true
        fi
    fi

    # 5c. Ensure panel launcher desktop files route through wrapper scripts
    for d in "${HOME}/.config/xfce4/panel"/launcher-*/*.desktop; do
        if [[ -f "${d}" ]]; then
            if grep -q "control-center" "${d}" 2>/dev/null; then
                sed -i 's|^Exec=.*|Exec='"${HOME}"'/.local/bin/control-center.sh|' "${d}" 2>/dev/null || true
            elif grep -q "spotlight" "${d}" 2>/dev/null; then
                sed -i 's|^Exec=.*|Exec='"${HOME}"'/.local/bin/spotlight.sh|' "${d}" 2>/dev/null || true
            fi
        fi
    done

    # 5d. Ensure applications .desktop files are deployed
    local app_dir="${HOME}/.local/share/applications"
    mkdir -p "${app_dir}"
    for app in launchpad.desktop spotlight.desktop control-center.desktop mission-control.desktop sequoia-settings.desktop; do
        if [[ -f "${REPO_ROOT}/config/applications/${app}" ]]; then
            cp -p "${REPO_ROOT}/config/applications/${app}" "${app_dir}/${app}"
            chmod +x "${app_dir}/${app}"
        fi
    done

    # 5e. Ensure Plank item for Launchpad (00-launchpad.dockitem and dconf)
    local plank_dir="${HOME}/.config/plank/dock1/launchers"
    if [[ -d "${plank_dir}" ]]; then
        cat << 'EOF' > "${plank_dir}/00-launchpad.dockitem"
[PlankDockItemPreferences]
Launcher=file:///home/sai/.local/share/applications/launchpad.desktop
EOF
    fi
    if command -v dconf &>/dev/null; then
        local current_items
        current_items="$(dconf read /net/launchpad/plank/docks/dock1/dock-items 2>/dev/null || echo "")"
        if [[ -n "${current_items}" ]]; then
            if [[ "${current_items}" != *"00-launchpad.dockitem"* ]]; then
                local new_items
                if [[ "${current_items}" == "['"* ]]; then
                    new_items="['00-launchpad.dockitem', ${current_items:2}"
                elif [[ "${current_items}" == "[]" ]]; then
                    new_items="['00-launchpad.dockitem']"
                else
                    new_items="['00-launchpad.dockitem']"
                fi
                dconf write /net/launchpad/plank/docks/dock1/dock-items "${new_items}" 2>/dev/null || true
            fi
        else
            dconf write /net/launchpad/plank/docks/dock1/dock-items "['00-launchpad.dockitem']" 2>/dev/null || true
        fi
    fi

    # 6. Checksum comparison
    log_info "Verifying deployment checksums (Repo vs Installed)..."
    local check_pairs=(
        "${SCRIPT_DIR}/sequoia-ctl:${bin_dest}/sequoia-ctl"
        "${REPO_ROOT}/lib/deskwidgets/bin/deskwidgets:${bin_dest}/deskwidgets"
        "${SCRIPT_DIR}/control-center.sh:${bin_dest}/control-center.sh"
        "${SCRIPT_DIR}/sequoia-control-center.py:${bin_dest}/sequoia-control-center.py"
        "${REPO_ROOT}/lib/deskwidgets/deskwidgets/paths.py:${share_dest}/deskwidgets/paths.py"
        "${REPO_ROOT}/lib/deskwidgets/deskwidgets/service.py:${share_dest}/deskwidgets/service.py"
        "${REPO_ROOT}/lib/deskwidgets/deskwidgets/cli.py:${share_dest}/deskwidgets/cli.py"
        "${REPO_ROOT}/lib/deskwidgets/deskwidgets/conky_check.py:${share_dest}/deskwidgets/conky_check.py"
        "${REPO_ROOT}/lib/deskwidgets/deskwidgets/keys.py:${share_dest}/deskwidgets/keys.py"
        "${REPO_ROOT}/lib/deskwidgets/engine/widget.conf:${share_dest}/engine/widget.conf"
        "${REPO_ROOT}/lib/sequoia_ui/__init__.py:${share_dest}/sequoia_ui/__init__.py"
        "${REPO_ROOT}/lib/sequoia_ui/css.py:${share_dest}/sequoia_ui/css.py"
        "${REPO_ROOT}/lib/sequoia_ui/tokens.py:${share_dest}/sequoia_ui/tokens.py"
        "${REPO_ROOT}/lib/sequoia_ui/window.py:${share_dest}/sequoia_ui/window.py"
        "${REPO_ROOT}/lib/sequoia_ui/telemetry.py:${share_dest}/sequoia_ui/telemetry.py"
    )

    local mismatches=0
    for pair in "${check_pairs[@]}"; do
        local src="${pair%%:*}"
        local dst="${pair##*:}"
        local src_hash dst_hash
        src_hash="$(sha256sum "${src}" 2>/dev/null | awk '{print $1}')"
        dst_hash="$(sha256sum "${dst}" 2>/dev/null | awk '{print $1}')"
        if [[ -n "${src_hash}" && "${src_hash}" == "${dst_hash}" ]]; then
            printf "   ${C_GREEN}✔${C_RESET} [MATCH] %-40s (%s)\n" "$(basename "${dst}")" "${dst_hash:0:12}"
        else
            printf "   ${C_RED}✖${C_RESET} [MISMATCH] %-40s (repo:%s != inst:%s)\n" "$(basename "${dst}")" "${src_hash:0:12}" "${dst_hash:0:12}"
            mismatches=$((mismatches + 1))
        fi
    done

    if [[ "${mismatches}" -gt 0 ]]; then
        log_error "Deployment failed: ${mismatches} file checksum mismatch(es) detected!"
        return 1
    fi

    # 7. Apply keyboard shortcuts via keys manager (manifest tracked)
    log_info "Applying desktop keyboard shortcuts via keys manager..."
    cmd_keys apply

    # 8. Restart affected components
    log_info "Restarting affected components with deployed files..."
    "${SCRIPT_DIR}/deskwidgets-manager.sh" restart

    local cc_val
    cc_val="$(grep -oE '"control_center":[[:space:]]*(true|false)' "${FEATURES_FILE}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "false")"
    if [[ "${cc_val}" == "false" ]]; then
        cmd_self_heal
    fi

    log_success "Deployment completed successfully. All components synced and verified."
}

cmd_self_test() {
    init_config
    init_features
    local overall_pass=1

    echo "======================================================================"
    printf "${C_CYAN}${C_BOLD}%s${C_RESET}\n" "                  SEQUOIA DESKTOP SYSTEM SELF-TEST"
    echo "======================================================================"

    # 1. Top Bar Check
    echo "1. TOP BAR (xfce4-panel)"
    local panel_pid
    panel_pid="$(pgrep -x xfce4-panel | head -n1 || true)"
    if [[ -n "${panel_pid}" ]]; then
        printf "   Process:             [MEASURED] ${C_GREEN}RUNNING (PID %s)${C_RESET}\n" "${panel_pid}"
        local struts autohide
        struts="$(xfconf-query -c xfce4-panel -p /panels/panel-1/enable-struts 2>/dev/null || echo "unknown")"
        autohide="$(xfconf-query -c xfce4-panel -p /panels/panel-1/autohide-behavior 2>/dev/null || echo "unknown")"
        printf "   Panel 1 Struts:      [CONFIGURED] %s (enable-struts = true)\n" "${struts}"
        printf "   Panel 1 Autohide:    [CONFIGURED] %s (autohide-behavior = 0)\n" "${autohide}"
        if [[ "${struts}" == "true" && "${autohide}" == "0" ]]; then
            printf "   Result:              ${C_GREEN}[PASS]${C_RESET}\n\n"
        else
            printf "   Result:              ${C_YELLOW}[WARN: struts=%s, autohide=%s]${C_RESET}\n\n" "${struts}" "${autohide}"
        fi
    else
        printf "   Process:             [MEASURED] ${C_RED}NOT RUNNING${C_RESET}\n"
        printf "   Result:              ${C_RED}[FAIL]${C_RESET}\n\n"
        overall_pass=0
    fi

    # 2. Dock Check
    echo "2. DOCK (plank)"
    local plank_pid
    plank_pid="$(pgrep -x plank | head -n1 || true)"
    if [[ -n "${plank_pid}" ]]; then
        printf "   Process:             [MEASURED] ${C_GREEN}RUNNING (PID %s)${C_RESET}\n" "${plank_pid}"
        local plank_win
        plank_win="$(wmctrl -l 2>/dev/null | grep -i "Plank" | head -n1 || true)"
        if [[ -n "${plank_win}" ]]; then
            printf "   Window Mapped:       [MEASURED] YES (%s)\n" "${plank_win}"
        else
            printf "   Window Mapped:       [MEASURED] UNKNOWN\n"
        fi

        if command -v dconf &>/dev/null; then
            local dconf_items
            dconf_items="$(dconf read /net/launchpad/plank/docks/dock1/dock-items 2>/dev/null || echo "")"
            if [[ -n "${dconf_items}" ]]; then
                printf "   Dconf Dock Items:    [MEASURED] %s\n" "${dconf_items}"
                if [[ "${dconf_items}" == *"00-launchpad.dockitem"* ]]; then
                    printf "   Launchpad Pinned:    [MEASURED] ${C_GREEN}YES (00-launchpad.dockitem listed in dconf)${C_RESET}\n"
                else
                    printf "   Launchpad Pinned:    [MEASURED] ${C_YELLOW}NO (missing from dconf dock-items)${C_RESET}\n"
                fi
            else
                printf "   Dconf Dock Items:    [MEASURED] NONE / UNCONFIGURED\n"
            fi
        fi
        printf "   Result:              ${C_GREEN}[PASS]${C_RESET}\n\n"
    else
        printf "   Process:             [MEASURED] ${C_RED}NOT RUNNING${C_RESET}\n"
        printf "   Result:              ${C_RED}[FAIL]${C_RESET}\n\n"
        overall_pass=0
    fi

    # 3. Compositor Check
    echo "3. COMPOSITOR (picom)"
    local picom_pid
    picom_pid="$(pgrep -x picom | head -n1 || true)"
    if [[ -n "${picom_pid}" ]]; then
        local pcmd="glx"
        if [[ -f "/proc/${picom_pid}/cmdline" ]]; then
            pcmd="$(tr '\0' ' ' < "/proc/${picom_pid}/cmdline" 2>/dev/null || echo "glx")"
        fi
        printf "   Process:             [MEASURED] ${C_GREEN}RUNNING (PID %s)${C_RESET}\n" "${picom_pid}"
        printf "   Backend:             [MEASURED] glx (Process: %s)\n" "${pcmd:0:60}"
        printf "   Config:              [CONFIGURED] %s\n" "${HOME}/.config/picom/picom.conf"
        printf "   Result:              ${C_GREEN}[PASS]${C_RESET}\n\n"
    else
        local xfwm_comp="false"
        xfwm_comp="$(xfconf-query -c xfwm4 -p /general/use_compositing 2>/dev/null || echo "false")"
        if [[ "${xfwm_comp}" == "true" ]]; then
            printf "   Status:              [MEASURED] ${C_YELLOW}SAFE-MODE (xfwm4 native compositing)${C_RESET}\n"
            printf "   Result:              ${C_YELLOW}[PASS - SAFE MODE]${C_RESET}\n\n"
        else
            printf "   Process:             [MEASURED] ${C_RED}NOT RUNNING${C_RESET}\n"
            printf "   Result:              ${C_RED}[FAIL]${C_RESET}\n\n"
            overall_pass=0
        fi
    fi

    # 4. DeskWidgets Check (runs deskwidgets status + deep diagnostics)
    echo "4. DESKWIDGETS (Cairo + Python + Conky)"
    local dw_runner="${REPO_ROOT}/lib/deskwidgets/bin/deskwidgets"
    if [[ -x "${HOME}/.local/bin/deskwidgets" ]]; then
        dw_runner="${HOME}/.local/bin/deskwidgets"
    fi

    # A. Deployment Sync Check
    echo "   --- Deployment Sync Check (Repo vs ~/.local) ---"
    local inst_share="${HOME}/.local/share/deskwidgets/deskwidgets"
    local inst_bin="${HOME}/.local/bin"
    local sync_ok=1
    local check_files=(
        "${SCRIPT_DIR}/sequoia-ctl:${inst_bin}/sequoia-ctl"
        "${REPO_ROOT}/lib/deskwidgets/bin/deskwidgets:${inst_bin}/deskwidgets"
        "${REPO_ROOT}/lib/deskwidgets/deskwidgets/paths.py:${inst_share}/paths.py"
        "${REPO_ROOT}/lib/deskwidgets/deskwidgets/service.py:${inst_share}/service.py"
        "${REPO_ROOT}/lib/deskwidgets/deskwidgets/cli.py:${inst_share}/cli.py"
        "${REPO_ROOT}/lib/deskwidgets/deskwidgets/conky_check.py:${inst_share}/conky_check.py"
        "${REPO_ROOT}/lib/deskwidgets/engine/widget.conf:${HOME}/.local/share/deskwidgets/engine/widget.conf"
        "${REPO_ROOT}/lib/sequoia_ui/__init__.py:${HOME}/.local/share/deskwidgets/sequoia_ui/__init__.py"
        "${REPO_ROOT}/lib/sequoia_ui/css.py:${HOME}/.local/share/deskwidgets/sequoia_ui/css.py"
        "${REPO_ROOT}/lib/sequoia_ui/tokens.py:${HOME}/.local/share/deskwidgets/sequoia_ui/tokens.py"
    )

    for cf in "${check_files[@]}"; do
        local rfile="${cf%%:*}"
        local ifile="${cf##*:}"
        if [[ ! -f "${ifile}" ]]; then
            printf "   ${C_RED}✖${C_RESET} [FAIL] Installed file missing: %s\n" "${ifile}"
            sync_ok=0
        else
            local r_sha i_sha
            r_sha="$(sha256sum "${rfile}" 2>/dev/null | awk '{print $1}')"
            i_sha="$(sha256sum "${ifile}" 2>/dev/null | awk '{print $1}')"
            if [[ "${r_sha}" != "${i_sha}" ]]; then
                printf "   ${C_RED}✖${C_RESET} [FAIL] installed copy differs from repo: %s (repo:%s != inst:%s)\n" "$(basename "${ifile}")" "${r_sha:0:8}" "${i_sha:0:8}"
                sync_ok=0
            fi
        fi
    done

    if [[ "${sync_ok}" -eq 1 ]]; then
        printf "   Deployment Sync:     [MEASURED] ${C_GREEN}[PASS] (All installed files match repository)${C_RESET}\n"
    else
        printf "   Deployment Sync:     [MEASURED] ${C_RED}[FAIL] (installed copy differs from repo; run 'sequoia-ctl deploy')${C_RESET}\n"
        overall_pass=0
    fi

    # B. Service Freshness Check
    local dw_srv_pid
    dw_srv_pid="$(cat "${HOME}/.cache/deskwidgets/service.pid" 2>/dev/null || pgrep -f "deskwidgets run" | head -n1 || true)"
    if [[ -n "${dw_srv_pid}" && -d "/proc/${dw_srv_pid}" ]]; then
        local srv_start_epoch inst_paths_epoch
        srv_start_epoch="$(stat -c %Y "/proc/${dw_srv_pid}" 2>/dev/null || echo 0)"
        inst_paths_epoch="$(stat -c %Y "${inst_share}/paths.py" 2>/dev/null || echo 0)"
        if (( srv_start_epoch > 0 && inst_paths_epoch > 0 && srv_start_epoch < inst_paths_epoch )); then
            local srv_time inst_time
            srv_time="$(date -d "@${srv_start_epoch}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "${srv_start_epoch}")"
            inst_time="$(date -d "@${inst_paths_epoch}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "${inst_paths_epoch}")"
            printf "   Service Freshness:   [MEASURED] ${C_RED}[FAIL] (service older than installed files: PID %s started at %s, files deployed at %s; restart required)${C_RESET}\n" \
                   "${dw_srv_pid}" "${srv_time}" "${inst_time}"
            overall_pass=0
        else
            printf "   Service Freshness:   [MEASURED] ${C_GREEN}[PASS] (service PID %s is current with deployed files)${C_RESET}\n" "${dw_srv_pid}"
        fi
    fi
    echo ""

    # C. Status Check (runs deskwidgets status)
    if python3 "${dw_runner}" status; then
        printf "   Status Check:        [MEASURED] ${C_GREEN}[PASS]${C_RESET}\n"
    else
        printf "   Status Check:        [MEASURED] ${C_RED}[FAIL]${C_RESET}\n"
        overall_pass=0
    fi
    echo ""

    # D. Log Filtering: Current run vs Previous run(s)
    echo "   --- DeskWidgets Log Filtering (~/.cache/sequoia/deskwidgets.log) ---"
    local log_file="${HOME}/.cache/sequoia/deskwidgets.log"
    [[ -f "${log_file}" ]] || log_file="${HOME}/.cache/deskwidgets/deskwidgets.log"

    if [[ -f "${log_file}" ]]; then
        if [[ -n "${dw_srv_pid}" ]]; then
            printf "   [CURRENT RUN - Service PID %s]:\n" "${dw_srv_pid}"
            local current_lines
            current_lines="$(grep -F "[PID ${dw_srv_pid}]" "${log_file}" 2>/dev/null | tail -n 25 || true)"
            if [[ -n "${current_lines}" ]]; then
                echo "${current_lines}" | while IFS= read -r line; do
                    printf "   | %s\n" "${line}"
                done
            else
                printf "   | (No log entries recorded for current service PID %s yet)\n" "${dw_srv_pid}"
            fi

            printf "\n   [PREVIOUS RUN(S)]:\n"
            local prev_lines
            prev_lines="$((grep -v -F "[PID ${dw_srv_pid}]" "${log_file}" 2>/dev/null || true) | tail -n 15 | awk '/^\[[0-9]{4}/ {p=1} p {print}')"
            if [[ -n "${prev_lines}" ]]; then
                echo "${prev_lines}" | while IFS= read -r line; do
                    printf "   | [previous run] %s\n" "${line}"
                done
            else
                printf "   | (none)\n"
            fi
        else
            printf "   (Service not running; showing last 25 lines of log):\n"
            local prev_lines
            prev_lines="$((tail -n 25 "${log_file}" 2>/dev/null || true) | awk '/^\[[0-9]{4}/ {p=1} p {print}')"
            if [[ -n "${prev_lines}" ]]; then
                echo "${prev_lines}" | while IFS= read -r line; do
                    printf "   | [previous run] %s\n" "${line}"
                done
            else
                printf "   | (none)\n"
            fi
        fi
    else
        echo "   | (No log file found at ~/.cache/sequoia/deskwidgets.log)"
    fi
    echo ""

    # E. Exact Conky command line and working directory
    echo "   --- Conky Command Line & Working Directory ---"
    local running_conky_pids
    running_conky_pids="$(pgrep -f "widget.conf" || true)"
    if [[ -n "${running_conky_pids}" ]]; then
        for cpid in ${running_conky_pids}; do
            local ccmd ccwd
            ccmd="$(tr '\0' ' ' < "/proc/${cpid}/cmdline" 2>/dev/null || echo "unknown")"
            ccwd="$(readlink "/proc/${cpid}/cwd" 2>/dev/null || echo "unknown")"
            printf "   Active PID %s: [MEASURED] %s\n" "${cpid}" "${ccmd}"
            printf "   Working Dir:    [MEASURED] %s\n" "${ccwd}"
        done
    else
        local srv_cwd="unknown"
        if [[ -n "${dw_srv_pid}" && -d "/proc/${dw_srv_pid}" ]]; then
            srv_cwd="$(readlink "/proc/${dw_srv_pid}/cwd" 2>/dev/null || echo "unknown")"
        fi
        local conf_target="${HOME}/.local/share/deskwidgets/engine/widget.conf"
        [[ -f "${conf_target}" ]] || conf_target="${REPO_ROOT}/lib/deskwidgets/engine/widget.conf"
        printf "   Status:         [MEASURED] NO ACTIVE CONKY PROCESSES FOUND\n"
        printf "   Target Cmd:     [CONFIGURED] conky -c %s\n" "${conf_target}"
        printf "   Service PID:    [MEASURED] %s\n" "${dw_srv_pid:-none}"
        printf "   Service CWD:    [MEASURED] %s\n" "${srv_cwd}"
    fi
    echo ""

    # F. Per-Widget Process Exit Codes & Stderr Capture
    echo "   --- Per-Widget Process Exit Codes & Stderr Capture ---"
    local widget_ids=("clock-1" "calendar-1" "weather-1" "system-1" "media-1")
    for wid in "${widget_ids[@]}"; do
        local err_file="${HOME}/.cache/sequoia/widgets/${wid}.stderr"
        local last_exit="none recorded"
        if [[ -f "${HOME}/.cache/sequoia/deskwidgets.log" ]]; then
            local exit_line
            exit_line="$(grep -F "[EXIT] Widget ${wid}" "${HOME}/.cache/sequoia/deskwidgets.log" 2>/dev/null | tail -n1 || true)"
            if [[ -n "${exit_line}" ]]; then
                last_exit="$(echo "${exit_line}" | sed -E 's/.*\[EXIT\] //')"
            fi
        fi
        printf "   • Widget: %-12s | Last Exit: [MEASURED] %s\n" "${wid}" "${last_exit}"
        if [[ -f "${err_file}" ]]; then
            local header
            header="$(head -n 1 "${err_file}" 2>/dev/null || true)"
            local spawn_lines
            spawn_lines="$(tail -n +2 "${err_file}" 2>/dev/null | grep -v '^[[:space:]]*$' || true)"
            if [[ -n "${spawn_lines}" ]]; then
                local spawn_bytes
                spawn_bytes="$(echo "${spawn_lines}" | wc -c || echo 0)"
                printf "     Spawn Header: [MEASURED] %s\n" "${header}"
                printf "     Stderr (%s bytes in current spawn) [MEASURED]:\n" "${spawn_bytes}"
                echo "${spawn_lines}" | tail -n 10 | while IFS= read -r eline; do
                    printf "       | %s\n" "${eline}"
                done
            else
                printf "     Stderr: [MEASURED] 0 bytes (clean spawn, no errors)\n"
            fi
        else
            printf "     Stderr: [MEASURED] (no stderr file at ~/.cache/sequoia/widgets/%s.stderr)\n" "${wid}"
        fi
    done
    echo ""

    # G. Conky Configuration & Lua Syntax Dry-Run Check
    echo "   --- Conky Configuration & Lua Syntax Dry-Run Check ---"
    local conf_to_test="${HOME}/.local/share/deskwidgets/engine/widget.conf"
    local widget_dir_to_test="${HOME}/.local/share/deskwidgets/widgets/clock"
    if [[ ! -f "${conf_to_test}" ]]; then
        conf_to_test="${REPO_ROOT}/lib/deskwidgets/engine/widget.conf"
        widget_dir_to_test="${REPO_ROOT}/lib/deskwidgets/widgets/clock"
    fi
    local engine_dir="$(dirname "${conf_to_test}")"
    local checker_py="${HOME}/.local/share/deskwidgets/deskwidgets/conky_check.py"
    [[ -f "${checker_py}" ]] || checker_py="${REPO_ROOT}/lib/deskwidgets/deskwidgets/conky_check.py"

    if command -v conky &>/dev/null; then
        printf "   Target File: [CONFIGURED] %s\n" "${conf_to_test}"
        printf "   Widget Dir:  [CONFIGURED] %s\n" "${widget_dir_to_test}"
        if [[ -f "${conf_to_test}" && -f "${checker_py}" ]]; then
            local dryrun_json
            set +e
            dryrun_json="$(python3 "${checker_py}" --run --conf "${conf_to_test}" --widget-dir "${widget_dir_to_test}" --pid "${dw_srv_pid:-0}" --json 2>&1)"
            set -e

            # Parse JSON fields safely via python
            local check_status check_reason check_cwd diff_count warn_count err_count
            check_status="$(echo "${dryrun_json}" | python3 -c 'import sys, json; data=json.load(sys.stdin); print(data.get("status","FAIL"))' 2>/dev/null || echo "FAIL")"
            check_reason="$(echo "${dryrun_json}" | python3 -c 'import sys, json; data=json.load(sys.stdin); print(data.get("reason","unknown error"))' 2>/dev/null || echo "parse error")"
            check_cwd="$(echo "${dryrun_json}" | python3 -c 'import sys, json; data=json.load(sys.stdin); print(data.get("cwd","unknown"))' 2>/dev/null || echo "unknown")"
            diff_count="$(echo "${dryrun_json}" | python3 -c 'import sys, json; data=json.load(sys.stdin); print(len(data.get("diffs",[])))' 2>/dev/null || echo 0)"
            warn_count="$(echo "${dryrun_json}" | python3 -c 'import sys, json; data=json.load(sys.stdin); print(len(data.get("warn_lines",[])))' 2>/dev/null || echo 0)"
            err_count="$(echo "${dryrun_json}" | python3 -c 'import sys, json; data=json.load(sys.stdin); print(len(data.get("error_lines",[])))' 2>/dev/null || echo 0)"

            printf "   Working Dir: [MEASURED] %s\n" "${check_cwd}"
            if (( diff_count > 0 )); then
                printf "   Env Diffs:   [MEASURED] %d variable difference(s) vs caller environment:\n" "${diff_count}"
                echo "${dryrun_json}" | python3 -c 'import sys, json; [print("     • " + d) for d in json.load(sys.stdin).get("diffs",[])]' 2>/dev/null || true
            else
                printf "   Env Diffs:   [MEASURED] (none, aligned with running service)\n"
            fi

            if [[ "${check_status}" == "PASS" ]]; then
                printf "   Dry-Run:     [MEASURED] ${C_GREEN}[PASS]${C_RESET} (%s)\n" "${check_reason}"
            elif [[ "${check_status}" == "PASS_WARN" ]]; then
                printf "   Dry-Run:     [MEASURED] ${C_YELLOW}[PASS - WITH WARNINGS]${C_RESET} (%s)\n" "${check_reason}"
                echo "${dryrun_json}" | python3 -c 'import sys, json; [print("     " + chr(27) + "[33m[WARN] " + w + chr(27) + "[0m") for w in json.load(sys.stdin).get("warn_lines",[])]' 2>/dev/null || true
            else
                printf "   Dry-Run:     [MEASURED] ${C_RED}[FAIL]${C_RESET} (%s)\n" "${check_reason}"
                echo "${dryrun_json}" | python3 -c 'import sys, json; [print("     " + chr(27) + "[31m[ERROR] " + e + chr(27) + "[0m") for e in json.load(sys.stdin).get("error_lines",[])]' 2>/dev/null || true
                overall_pass=0
            fi
        else
            printf "   Dry-Run:     [MEASURED] ${C_RED}[FAIL]${C_RESET} (Required files missing: conf=%s, checker=%s)\n" "${conf_to_test}" "${checker_py}"
            overall_pass=0
        fi
    else
        printf "   Dry-Run:     [MEASURED] ${C_RED}[FAIL]${C_RESET} ('conky' binary not found in PATH)\n"
        overall_pass=0
    fi
    echo ""

    # H. Conky Build Information (conky -v)
    echo "   --- Conky Build Information & Flags (conky -v) ---"
    if command -v conky &>/dev/null; then
        local cver_full
        cver_full="$(conky -v 2>&1 || true)"
        local cver
        cver="$(echo "${cver_full}" | head -n 1)"
        printf "   Binary:        [MEASURED] %s\n" "$(command -v conky)"
        printf "   Version:       [MEASURED] %s\n" "${cver}"
        printf "   Build Flags:   [MEASURED]\n"
        echo "${cver_full}" | grep -i -E "lua|cairo|imlib|x11|argb|xdbe|xft" | while IFS= read -r fline; do
            printf "     | %s\n" "${fline}"
        done
    else
        printf "   Conky binary:  [MEASURED] NOT FOUND\n"
    fi
    echo ""

    # I. Features Gate Configuration
    echo "   --- Features Gate Configuration (~/.config/sequoia/features.json) ---"
    if [[ -f "${FEATURES_FILE}" ]]; then
        printf "   File:     [CONFIGURED] %s\n" "${FEATURES_FILE}"
        printf "   Content:  [CONFIGURED] %s\n" "$(cat "${FEATURES_FILE}")"
    else
        printf "   File:     [CONFIGURED] %s (NOT FOUND - defaults to {\"control_center\": false})\n" "${FEATURES_FILE}"
    fi
    echo ""

    # J. Persisted Self-Heal Counters
    echo "   --- Persisted Self-Heal Counters & State Inspection ---"
    echo "   Storage Mechanism:   [CONFIGURED] In-memory only (held in Python Daemon.runners dictionary)"
    echo "   Restart Persistence: [CONFIGURED] NONE (counters and backoff levels reset to 0 upon process start)"
    local lock_found=0
    for f in "${HOME}/.cache/deskwidgets"/*.lock "${HOME}/.cache/deskwidgets"/*.state "${HOME}/.config/deskwidgets"/*.lock "${HOME}/.config/deskwidgets"/*.state; do
        if [[ -f "${f}" ]]; then
            printf "   Found state/lock file: [MEASURED] %s\n" "${f}"
            lock_found=1
        fi
    done
    if [[ "${lock_found}" -eq 0 ]]; then
        printf "   On-Disk Lock/State:  [MEASURED] NONE (no persistent lockout files blocking spawns)\n"
    fi
    echo ""

    # K. D-Bus Registration
    echo "   --- D-Bus Session Bus Registration (io.github.toksik.DeskWidgets) ---"
    local dbus_owner="NONE"
    local dbus_pid="NONE"
    if command -v dbus-send &>/dev/null; then
        dbus_owner="$(dbus-send --session --dest=org.freedesktop.DBus --type=method_call --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetNameOwner string:"io.github.toksik.DeskWidgets" 2>/dev/null | grep string | cut -d'"' -f2 || echo "NONE")"
        if [[ -n "${dbus_owner}" && "${dbus_owner}" != "NONE" ]]; then
            dbus_pid="$(dbus-send --session --dest=org.freedesktop.DBus --type=method_call --print-reply /org/freedesktop/DBus org.freedesktop.DBus.GetConnectionUnixProcessID string:"${dbus_owner}" 2>/dev/null | grep uint32 | awk '{print $2}' || echo "NONE")"
        fi
    elif command -v gdbus &>/dev/null; then
        dbus_owner="$(gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus --method org.freedesktop.DBus.GetNameOwner "io.github.toksik.DeskWidgets" 2>/dev/null | cut -d"'" -f2 || echo "NONE")"
    fi
    printf "   Name Owner: [MEASURED] %s\n" "${dbus_owner}"
    if [[ -n "${dbus_pid}" && "${dbus_pid}" != "NONE" ]]; then
        printf "   Owner PID:  [MEASURED] %s\n" "${dbus_pid}"
    fi
    echo ""

    # 5. Control Center State
    echo "5. CONTROL CENTER"
    local cc_enabled="false"
    if [[ -f "${FEATURES_FILE}" ]]; then
        cc_enabled="$(grep -oE '"control_center":[[:space:]]*(true|false)' "${FEATURES_FILE}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "false")"
    fi
    local cc_pid
    cc_pid="$(pgrep -f "sequoia-control-center.py" | head -n1 || true)"
    if [[ "${cc_enabled}" == "true" ]]; then
        printf "   Feature Flag:        [CONFIGURED] ${C_GREEN}ENABLED${C_RESET}\n"
        if [[ -n "${cc_pid}" ]]; then
            printf "   Process:             [MEASURED] RUNNING (PID %s)\n" "${cc_pid}"
        else
            printf "   Process:             [MEASURED] IDLE (on-demand via Super+C)\n"
        fi
        printf "   Result:              ${C_GREEN}[PASS]${C_RESET}\n\n"
    else
        printf "   Feature Flag:        [CONFIGURED] ${C_YELLOW}DISABLED${C_RESET} (behind 'sequoia-ctl feature enable control-center')\n"
        if [[ -n "${cc_pid}" ]]; then
            local cc_cmd cc_start cc_ppid
            cc_cmd="$(tr '\0' ' ' < "/proc/${cc_pid}/cmdline" 2>/dev/null || echo "unknown")"
            cc_start="$(ps -p "${cc_pid}" -o lstart= 2>/dev/null || echo "unknown")"
            cc_ppid="$(ps -p "${cc_pid}" -o ppid= 2>/dev/null || echo "unknown")"
            printf "   Process:             [MEASURED] ${C_RED}RUNNING (PID %s - unexpected while feature disabled!)${C_RESET}\n" "${cc_pid}"
            printf "   Process Cmdline:     [MEASURED] %s\n" "${cc_cmd}"
            printf "   Process Start Time:  [MEASURED] %s\n" "${cc_start}"
            printf "   Process PPID:        [MEASURED] %s\n" "${cc_ppid}"
            printf "   Result:              ${C_RED}[FAIL] (Process running while feature disabled. Run 'sequoia-ctl self-heal' or 'sequoia-ctl deploy' to clean up)${C_RESET}\n\n"
            overall_pass=0
        else
            printf "   Process:             [MEASURED] NOT RUNNING\n"
            printf "   Result:              ${C_GREEN}[PASS] (disabled as intended)${C_RESET}\n\n"
        fi
    fi

    # 6. Effective Hardware Profile Check (Task 5 requirement)
    echo "6. EFFECTIVE HARDWARE & VISUAL PROFILE"
    local cur_profile="lite"
    if [[ -f "${USER_CONFIG}" ]]; then
        cur_profile="$(grep -oE '"profile":[[:space:]]*"[^"]+"' "${USER_CONFIG}" 2>/dev/null | cut -d'"' -f4 || echo "lite")"
    fi
    printf "   Effective Profile:   [CONFIGURED] ${C_BOLD}%s${C_RESET} (Default for GT 610: lite = flat translucent, 0 GPU blur)\n" "${cur_profile}"
    printf "   Compositor Config:   [CONFIGURED] %s\n" "${HOME}/.config/picom/picom.conf"
    printf "   Result:              ${C_GREEN}[PASS]${C_RESET}\n\n"

    # 7. Keyboard Shortcuts & Non-Keyboard Triggers
    echo "7. KEYBOARD SHORTCUTS & NON-KEYBOARD TRIGGERS"
    local keys_check_pass=1
    if ! cmd_keys check >/dev/null 2>&1; then
        keys_check_pass=0
    fi
    local super_state="DISABLED"
    if [[ -f "${CONFIG_DIR}/keys.json" ]]; then
        local s_val
        s_val="$(grep -oE '"super_enabled":[[:space:]]*(true|false)' "${CONFIG_DIR}/keys.json" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "false")"
        [[ "${s_val}" == "true" ]] && super_state="ENABLED"
    fi
    printf "   Conflict Check:      [MEASURED] %s\n" "$([[ "${keys_check_pass}" -eq 1 ]] && echo "PASS (zero conflicts detected)" || echo "CONFLICTS DETECTED")"
    printf "   Super Key Mode:      [CONFIGURED] %s (Zero Super key dependence)\n" "${super_state}"

    # Legacy bindings scan
    local legacy_out
    legacy_out="$(cmd_keys scan-legacy 2>/dev/null || echo "")"
    if [[ -n "${legacy_out}" ]]; then
        local leg_count
        leg_count="$(echo "${legacy_out}" | grep -c "\[LEGACY\]" || echo 0)"
        if (( leg_count > 0 )); then
            printf "   Legacy Shortcuts:    [MEASURED] ${C_YELLOW}%d unmanaged binding(s) detected (run 'sequoia-ctl keys adopt-legacy')${C_RESET}\n" "${leg_count}"
        else
            printf "   Legacy Shortcuts:    [MEASURED] ${C_GREEN}0 unmanaged legacy bindings${C_RESET}\n"
        fi
    fi

    # Non-keyboard triggers
    local cc_trigger="routes to wrapper (~/.local/bin/control-center.sh)"
    local sp_trigger="routes to wrapper (~/.local/bin/spotlight.sh)"
    printf "   Top Bar CC Button:   [CONFIGURED] PRESENT (%s)\n" "${cc_trigger}"
    printf "   Top Bar Spotlight:   [CONFIGURED] PRESENT (%s)\n" "${sp_trigger}"

    local plank_lp="${HOME}/.config/plank/dock1/launchers/00-launchpad.dockitem"
    if [[ -f "${plank_lp}" ]]; then
        printf "   Plank Launchpad Dock:[CONFIGURED] PRESENT (%s)\n" "${plank_lp}"
    else
        printf "   Plank Launchpad Dock:[CONFIGURED] AVAILABLE (~/.local/share/applications/launchpad.desktop)\n"
    fi

    # Zero Resident Watchers (no hot-corner daemon)
    local hot_pids
    hot_pids="$(pgrep -f "hot-corner" 2>/dev/null || true)"
    if [[ -z "${hot_pids}" ]]; then
        printf "   Resident Watchers:   [MEASURED] ZERO (no resident hot-corner / key daemon)\n"
        printf "   Result:              ${C_GREEN}[PASS]${C_RESET}\n\n"
    else
        printf "   Resident Watchers:   [MEASURED] ${C_RED}FOUND (PID %s)${C_RESET}\n" "${hot_pids}"
        printf "   Result:              ${C_RED}[FAIL]${C_RESET}\n\n"
        overall_pass=0
    fi

    echo "----------------------------------------------------------------------"
    if [[ "${overall_pass}" -eq 1 ]]; then
        printf "${C_GREEN}${C_BOLD}%s${C_RESET}\n" "FINAL RESULT: ALL COMPONENTS HEALTHY"
        echo "======================================================================"
        return 0
    else
        printf "${C_RED}${C_BOLD}%s${C_RESET}\n" "FINAL RESULT: COMPONENT FAILURES DETECTED"
        echo "======================================================================"
        return 1
    fi
}

cmd_self_heal() {
    init_config
    init_features
    log_info "Running Sequoia Desktop self-heal..."

    local cc_val
    cc_val="$(grep -oE '"control_center":[[:space:]]*(true|false)' "${FEATURES_FILE}" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ' || echo "false")"

    if [[ "${cc_val}" == "false" ]]; then
        local cc_pids
        cc_pids="$(pgrep -f "sequoia-control-center.py" || true)"
        if [[ -n "${cc_pids}" ]]; then
            for pid in ${cc_pids}; do
                if [[ -f "/proc/${pid}/cmdline" ]]; then
                    local cmd
                    cmd="$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true)"
                    if [[ "${cmd}" == *"sequoia-control-center.py"* ]]; then
                        log_warn "Terminating unauthorized background Control Center process (PID ${pid}, cmd: ${cmd})..."
                        kill -TERM "${pid}" 2>/dev/null || true
                        sleep 0.5
                        if kill -0 "${pid}" 2>/dev/null; then
                            kill -KILL "${pid}" 2>/dev/null || true
                        fi
                        log_success "Terminated Control Center PID ${pid} safely."
                    fi
                fi
            done
        else
            log_info "No rogue Control Center processes found."
        fi
    fi
    log_success "Self-heal complete."
}

case "${1:-status}" in
    status) cmd_status ;;
    deploy) cmd_deploy ;;
    rollback) shift; cmd_rollback "$@" ;;
    keys) shift; cmd_keys "$@" ;;
    self-test) cmd_self_test ;;
    self-heal) cmd_self_heal ;;
    feature) shift; cmd_feature "$@" ;;
    preset) shift; cmd_preset "$@" ;;
    apply) cmd_apply ;;
    apps|fix-windows) cmd_apps ;;
    edit) shift; cmd_edit "$@" ;;
    safe-mode) shift; cmd_safe_mode "$@" ;;
    export) shift; cmd_export "$@" ;;
    import) shift; cmd_import "$@" ;;
    -h|--help|help)
        echo "Sequoia Control CLI (sequoia-ctl)"
        echo "Usage: sequoia-ctl <command> [args]"
        echo ""
        echo "Commands:"
        echo "  deploy                Synchronize repository files to ~/.local with backup, verification and restart"
        echo "  rollback [id|latest]  Restore installed binaries, package, and manifest-owned shortcuts from backup"
        echo "  keys [args]           Manage keyboard shortcuts as data (list, check, set, reset, super, apply)"
        echo "  self-test             Run comprehensive verification of all components and geometry"
        echo "  self-heal             Safely terminate rogue processes and clean stale state"
        echo "  status                Show running session state and components"
        echo "  feature [list|enable|disable|trial <name>] Manage optional desktop features (e.g. control-center)"
        echo "  preset [name]         List presets or apply a preset (default, vibrant, sequoia-dark, enterprise)"
        echo "  apps                  Configure Brave/browsers/apps for native macOS traffic lights and remove top gap"
        echo "  edit on|off           Unlock or lock panel layout for drag/reposition"
        echo "  safe-mode on|off      Toggle Picom vs xfwm4 safe compositing"
        echo "  export <file.json>    Export active configuration"
        echo "  import <file.json>    Import configuration"
        ;;
    *)
        log_error "Unknown command: $1"
        echo "Run 'sequoia-ctl --help' for usage."
        exit 1
        ;;
esac
