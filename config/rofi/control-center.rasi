/* ==============================================================================
 * macOS Sequoia Control Center Theme for Rofi
 * Anchored to the top-right of the screen directly beneath the top menu bar
 * ============================================================================== */

configuration {
    show-icons:                 false;
    font:                       "Inter 10";
}

* {
    bg-col:                     #1c1d24f5;
    bg-item:                    #ffffff0f;
    selected-col:               #007aff;
    fg-col:                     #f5f5f7;
    fg-muted:                   #94a3b8;
    border-col:                 #ffffff22;
}

window {
    transparency:               "real";
    background-color:           @bg-col;
    text-color:                 @fg-col;
    border:                     1px solid;
    border-color:               @border-col;
    border-radius:              16px;
    width:                      340px;
    location:                   north east;
    anchor:                     north east;
    x-offset:                   -12px;
    y-offset:                   34px;
    padding:                    12px;
}

mainbox {
    background-color:           transparent;
    children:                   [ inputbar, listview ];
    spacing:                    8px;
}

inputbar {
    background-color:           transparent;
    text-color:                 @fg-col;
    padding:                    4px 6px;
    children:                   [ prompt ];
}

prompt {
    background-color:           transparent;
    text-color:                 #00f0ff;
    font:                       "Inter Bold 11";
}

listview {
    background-color:           transparent;
    columns:                    1;
    lines:                      10;
    cycle:                      false;
    dynamic:                    true;
    layout:                     vertical;
    spacing:                    5px;
}

element {
    background-color:           @bg-item;
    text-color:                 @fg-col;
    border-radius:              10px;
    padding:                    8px 12px;
    spacing:                    8px;
    children:                   [ element-text ];
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    vertical-align:             0.5;
}

element selected {
    background-color:           @selected-col;
    text-color:                 #ffffff;
}
