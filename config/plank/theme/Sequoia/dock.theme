# ==============================================================================
# macOS Sequoia Plank Dock Theme
# Derived from reference/design-tokens.conf
# ==============================================================================

[PlankTheme]
# The roundness of the dock edges (reference: dock_radius=14px)
TopRoundness=14
BottomRoundness=14

# The thickness of the dock's border
LineWidth=1

# The color of the outer stroke (R;;G;;B;;A)
OuterStrokeColor=255;;255;;255;;46

# Background gradient (R;;G;;B;;A)
FillStartColor=35;;35;;40;;179
FillEndColor=35;;35;;40;;179

# Inner subtle glow stroke (R;;G;;B;;A)
InnerStrokeColor=255;;255;;255;;25

# Spacing & Padding (balanced 2px padding top/bottom to prevent empty space under icons)
BottomPadding=2
TopPadding=2
ItemPadding=4
IndicatorSize=4
IconShadowSize=1
FadeOpacity=1


