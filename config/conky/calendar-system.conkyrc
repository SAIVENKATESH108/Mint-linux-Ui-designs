-- ==============================================================================
-- Conky Window 2: Calendar & System Sensors Widget (macOS Sequoia)
-- Target Hardware: Intel Core i3-3220, 12GB RAM, GT 610, 1280x1024
-- ==============================================================================

conky.config = {
    alignment = 'top_right',
    background = false,
    border_width = 1,
    cpu_avg_samples = 2,
    default_color = '#FFFFFF',
    default_outline_color = '#FFFFFF',
    default_shade_color = '#000000',
    double_buffer = true,
    draw_borders = false,
    draw_graph_borders = false,
    draw_outline = false,
    draw_shades = false,
    extra_newline = false,
    font = 'Inter:size=9',
    gap_x = 14,
    gap_y = 194,
    minimum_height = 230,
    minimum_width = 320,
    maximum_width = 320,
    net_avg_samples = 2,
    no_buffers = true,
    out_to_console = false,
    out_to_ncurses = false,
    out_to_stderr = false,
    out_to_x = true,
    own_window = true,
    own_window_class = 'conky',
    own_window_type = 'normal',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 120,
    own_window_colour = '1E293B',
    override_utf8_locale = true,
    show_graph_range = false,
    show_graph_scale = false,
    stippled_borders = 0,
    update_interval = 3.5,
    uppercase = false,
    use_spacer = 'none',
    use_xft = true,
}

conky.text = [[
${color #94A3B8}${font Inter:bold:size=8}CALENDAR & SYSTEM SENSORS${alignr}CARD 2${font}${color}
${color #334155}${hr 1}${color}
${color #F43F5E}${font Inter:bold:size=11}${time %B %Y}${alignr}${color #F43F5E}TODAY: ${time %a %d}${color}${font}
${color #94A3B8}${font JetBrains Mono:size=8}${execpi 3600 cal | sed 's/^/  /' | sed 's/'"$(date +%e | sed 's/ //g')"'/${color #0A84FF}&${color #94A3B8}/'}${font}${color}
${voffset 4}${color #334155}${hr 1}${color}
${color #94A3B8}CPU (i3-3220):${alignr}${color #38BDF8}${cpu cpu0}%  ${color #F59E0B}(${execi 10 sensors 2>/dev/null | grep 'Core 0' | awk '{print $3}' | tr -d '+' | sed 's/°//g' || echo "34 C"})${color}
${color #334155}${cpubar 4,320}${color}
${color #94A3B8}RAM (12 GB):${alignr}${color #38BDF8}${mem} / ${memmax} (${memperc}%)${color}
${color #334155}${membar 4,320}${color}
${color #94A3B8}System Uptime:${alignr}${color #10B981}${uptime}${color}
]]
