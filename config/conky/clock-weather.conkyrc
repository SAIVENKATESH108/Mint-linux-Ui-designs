-- ==============================================================================
-- Conky Window 1: Clock & Weather Widget (macOS Sequoia Glance)
-- Target Hardware: Intel Core i3-3220, NVIDIA GT 610, 1280x1024
-- ==============================================================================

conky.config = {
    alignment = 'top_right',
    background = false,
    border_width = 1,
    cpu_avg_samples = 2,
    default_color = '#FFFFFF',
    default_outline_color = '#FFFFFF',
    default_shade_color = '#000000',
    double_buffer = true,
    draw_borders = false,
    draw_graph_borders = false,
    draw_outline = false,
    draw_shades = false,
    extra_newline = false,
    font = 'Inter:size=10',
    gap_x = 14,
    gap_y = 38,
    minimum_height = 140,
    minimum_width = 320,
    maximum_width = 320,
    net_avg_samples = 2,
    no_buffers = true,
    out_to_console = false,
    out_to_ncurses = false,
    out_to_stderr = false,
    out_to_x = true,
    own_window = true,
    own_window_class = 'conky',
    own_window_type = 'desktop',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    show_graph_range = false,
    show_graph_scale = false,
    stippled_borders = 0,
    update_interval = 3.5,
    uppercase = false,
    use_spacer = 'none',
    use_xft = true,
}

conky.text = [[
${color #94A3B8}${font Inter:bold:size=8}GLANCE • TIME & WEATHER${alignr}CARD 1${font}${color}
${color #334155}${hr 1}${color}
${voffset 6}${color #FFFFFF}${font Inter:bold:size=28}${time %l:%M}${font Inter:size=14}${time %p}${font}${alignr}${font Inter:bold:size=13}San Francisco${font}
${color #94A3B8}${font Inter:size=10}${time %A, %B %e}${alignr}${execi 1800 ~/.local/bin/weather-cache.sh}${font}${color}
${voffset 4}${color #334155}${hr 1}${color}
${color #94A3B8}${font Inter:size=9}Conditions:${alignr}${color #38BDF8}${execi 1800 cat /tmp/wttr_cache.txt 2>/dev/null || echo "Clear +21°C"}${color}
]]
