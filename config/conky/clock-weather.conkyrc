-- ==============================================================================
-- Conky Window 1: Clock & Weather Widget (macOS Sequoia Translucent Glass Card)
-- Target Hardware: Intel Core i3-3220, NVIDIA GT 610, 1280x1024
-- ==============================================================================

conky.config = {
    alignment = 'top_right',
    background = false,
    border_width = 1,
    border_inner_margin = 10,
    cpu_avg_samples = 2,
    default_color = '#FFFFFF',
    default_outline_color = '#2d3748',
    default_shade_color = '#000000',
    double_buffer = true,
    draw_borders = true,
    draw_graph_borders = false,
    draw_outline = false,
    draw_shades = false,
    extra_newline = false,
    font = 'Inter:size=9',
    gap_x = 14,
    gap_y = 36,
    minimum_height = 110,
    minimum_width = 310,
    maximum_width = 310,
    net_avg_samples = 2,
    no_buffers = true,
    out_to_console = false,
    out_to_ncurses = false,
    out_to_stderr = false,
    out_to_x = true,
    own_window = true,
    own_window_class = 'conky',
    own_window_type = 'normal',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 185,
    own_window_colour = '141722',
    override_utf8_locale = true,
    show_graph_range = false,
    show_graph_scale = false,
    stippled_borders = 0,
    update_interval = 3.5,
    uppercase = false,
    use_spacer = 'none',
    use_xft = true,
}

conky.text = [[
${color #38BDF8}${font Inter:bold:size=8}GLANCE • TIME & WEATHER${alignr}${color #94A3B8}CARD 1${font}${color}
${color #334155}${hr 1}${color}
${voffset 2}${color #FFFFFF}${font Inter:bold:size=22}${time %l:%M %p}${font}${alignr}${color #38BDF8}${font Inter:bold:size=11}San Francisco${font}
${color #94A3B8}${font Inter:size=9}${time %A, %B %e}${alignr}${color #00FF9D}${font Inter:bold:size=9}${execi 1800 ~/.local/bin/weather-cache.sh || echo "Clear +21°C"}${font}${color}
]]
