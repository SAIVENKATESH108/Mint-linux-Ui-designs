-- ==============================================================================
-- Conky Window 3: Media, Storage & Network Widget (macOS Sequoia)
-- Target Hardware: Intel Core i3-3220, NVIDIA GT 610, 1280x1024
-- ==============================================================================

conky.config = {
    alignment = 'top_right',
    background = false,
    border_width = 1,
    cpu_avg_samples = 2,
    default_color = '#FFFFFF',
    default_outline_color = '#FFFFFF',
    default_shade_color = '#000000',
    double_buffer = true,
    draw_borders = false,
    draw_graph_borders = false,
    draw_outline = false,
    draw_shades = false,
    extra_newline = false,
    font = 'Inter:size=9',
    gap_x = 14,
    gap_y = 440,
    minimum_height = 200,
    minimum_width = 320,
    maximum_width = 320,
    net_avg_samples = 2,
    no_buffers = true,
    out_to_console = false,
    out_to_ncurses = false,
    out_to_stderr = false,
    out_to_x = true,
    own_window = true,
    own_window_class = 'conky',
    own_window_type = 'normal',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 120,
    own_window_colour = '1E293B',
    override_utf8_locale = true,
    show_graph_range = false,
    show_graph_scale = false,
    stippled_borders = 0,
    update_interval = 3.5,
    uppercase = false,
    use_spacer = 'none',
    use_xft = true,
}

conky.text = [[
${color #94A3B8}${font Inter:bold:size=8}MEDIA, STORAGE & NETWORK${alignr}CARD 3${font}${color}
${color #334155}${hr 1}${color}
${color #F43F5E}${font Inter:bold:size=10}NOW PLAYING${font}${color}
${color #FFFFFF}${font Inter:size=9}${execi 5 playerctl metadata --format '{{title}}' 2>/dev/null || echo "No active media"}${font}${color}
${color #94A3B8}${font Inter:size=8}${execi 5 playerctl metadata --format '{{artist}} - {{album}}' 2>/dev/null || echo "Play music to display track"}${font}${color}
${voffset 4}${color #334155}${hr 1}${color}
${color #94A3B8}Disk (/):${alignr}${color #38BDF8}${fs_used /} / ${fs_size /} (${fs_used_perc /}%)${color}
${color #334155}${fs_bar 4,320 /}${color}
${voffset 4}${color #334155}${hr 1}${color}
${color #94A3B8}Network Status:${alignr}${color #10B981}Connected (1 Gbps)${color}
${color #94A3B8}Down: ${color #38BDF8}${downspeed enp3s0}${color}${alignr}${color #94A3B8}Up: ${color #F59E0B}${upspeed enp3s0}${color}
]]
